@model List<Banky.Web.Models.AdminPosPointModel>
@{
    ViewData["Title"] = "نقاط البيع والمتاجر (POS)";
}

<div class="card bg-body rounded-4 p-4 shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold mb-1"><i class="fa-solid fa-store text-primary me-2"></i> شبكة نقاط البيع والمتاجر المسجلة</h5>
            <p class="text-muted small mb-0">متابعة كافة نقاط البيع المنشأة بواسطة العملاء والتجار وحجم مبيعاتها المسجلة</p>
        </div>
        <div class="badge bg-info text-dark fs-6 px-3 py-2 rounded-pill">
            <i class="fa-solid fa-shop me-1"></i> @Model.Count نقطة بيع
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-store-slash fs-1 mb-2"></i>
            <p class="mb-0">لا توجد نقاط بيع مسجلة بعد في النظام</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>اسم نقطة البيع</th>
                        <th>كود الـ POS</th>
                        <th>التاجر المالك</th>
                        <th>رقم هاتف التاجر</th>
                        <th>النشاط</th>
                        <th>العنوان</th>
                        <th>إجمالي المبيعات</th>
                        <th>عدد العمليات</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pos in Model)
                    {
                        <tr>
                            <td class="fw-bold">@pos.Name</td>
                            <td class="font-monospace text-primary fw-bold">@pos.PosCode</td>
                            <td>
                                <a asp-controller="Clients" asp-action="Details" asp-route-id="@pos.ClientId" class="text-decoration-none">
                                    @pos.MerchantName
                                </a>
                            </td>
                            <td dir="ltr" class="text-end">@pos.MerchantPhone</td>
                            <td><span class="badge bg-secondary-subtle text-secondary">@pos.Category</span></td>
                            <td class="small text-muted">@pos.Address</td>
                            <td class="fw-bold text-success">@pos.TotalSalesAmount.ToString("N2")</td>
                            <td class="small">@pos.TotalSalesCount عملية</td>
                            <td>
                                @if (pos.IsActive)
                                {
                                    <span class="badge bg-success">نشطة</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">معطلة</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
