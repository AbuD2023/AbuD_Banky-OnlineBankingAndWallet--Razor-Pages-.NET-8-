@model Banky.Web.Models.AdminLoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل دخول الإدارة";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل دخول الإدارة - Banky</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        [data-bs-theme="dark"] body {
            background: linear-gradient(135deg, #10172a 0%, #0b0f19 100%);
        }

        .login-card {
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            border: none;
            overflow: hidden;
            max-width: 440px;
            width: 100%;
        }

        .login-header {
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
            color: #fff;
            padding: 35px 25px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container p-3">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card login-card bg-body">
                    <div class="login-header">
                        <div class="bg-white text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow" style="width: 64px; height: 64px;">
                            <i class="fa-solid fa-building-columns fs-2"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Banky Dashboard</h3>
                        <p class="mb-0 text-white-50">لوحة تحكم النظام المصرفي والمحفظة</p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small p-3 mb-3"></div>

                            <div class="mb-3">
                                <label asp-for="Identifier" class="form-label fw-bold small">البريد الإلكتروني أو رقم الهاتف</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-envelope text-muted"></i></span>
                                    <input asp-for="Identifier" class="form-control" placeholder="admin@banky.com أو 777000000" />
                                </div>
                                <span asp-validation-for="Identifier" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password" class="form-label fw-bold small">كلمة المرور</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-body-tertiary"><i class="fa-solid fa-lock text-muted"></i></span>
                                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" />
                                    <label asp-for="RememberMe" class="form-check-label small"></label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm rounded-3">
                                <i class="fa-solid fa-right-to-bracket me-2"></i> تسجيل الدخول
                            </button>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-3 text-muted small">
                    نظام Banky - لوحة التحكم الإدارية
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
